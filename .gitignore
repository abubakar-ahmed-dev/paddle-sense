# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets; the template IS committed
.env*
!.env.example

# local-only files
competition-details.txt

# python predict service (Phase 4)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# local runtime caches (weather series etc.)
.cache/

# temporal CLI binary (dev server; downloaded per machine, not committed)
/tools/

# local agent settings
.claude/

# vercel
.vercel

# playwright artifacts
test-results/
playwright-report/

# typescript
*.tsbuildinfo
next-env.d.ts
