# Copy to .env and fill in. NEVER commit .env.

# Tiger Data (free plan) — Postgres connection string with pgvector
DATABASE_URL=postgresql://user:password@host:port/dbname

# SerpApi (free plan, 100 searches/month)
SERPAPI_KEY=

# Hosted open-weight model (pick one free provider; get key at build time)
# Google AI Studio: https://aistudio.google.com/apikey  (Gemma, free tier)
# Groq: https://console.groq.com/keys                 (open models, free tier)
# Together: https://api.together.xyz/settings/api-keys
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemma-3-27b-it

# Shared secret for app/worker -> predict-service auth (Phase 4)
X_INTERNAL_TOKEN=

# Predict service base URL (Phase 4; dev default, Render internal URL in prod)
PREDICT_URL=http://localhost:8000

# Weekly email nudge (Phase 7, optional) — Resend or Gmail SMTP
NOTIFY_EMAIL_PROVIDER=resend
NOTIFY_EMAIL_KEY=
NOTIFY_EMAIL_TO=

# Optional: Sentry (free dev plan) for agent tracing
SENTRY_DSN=

# Optional: ElevenLabs (free tier) — audio river briefing
ELEVENLABS_API_KEY=
