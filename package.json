{
  "name": "paddle-sense",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --exclude tests/workflows",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "node --env-file=.env scripts/seed-rivers.mjs",
    "backfill": "node --env-file=.env scripts/backfill.mjs",
    "sync": "npm run backfill",
    "backtest": "node --env-file=.env scripts/backtest.mjs --all",
    "predict": "node --env-file=.env scripts/predict.mjs --all",
    "range-candidates": "node --env-file=.env scripts/list-range-candidates.mjs",
    "temporal:dev": "tools/temporal.exe server start-dev --db-filename .cache/temporal-dev.db --port 7233 --ui-port 8233",
    "start:worker": "tsx --env-file=.env workers/worker.ts",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@temporalio/testing": "^1.24.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@swc/core": "1.12.9"
  }
}
